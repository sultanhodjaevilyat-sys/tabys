# Скопируйте этот файл в .env и вставьте свои ключи. Файл .env НЕ попадает в GitHub.

# База: по умолчанию SQLite-файл. Для PostgreSQL (docker compose up db):
# DATABASE_URL=postgresql+psycopg2://tabys:tabys@localhost:5432/tabys
DATABASE_URL=sqlite:///./tabys.db

FRONTEND_URL=http://localhost:5173

# AI-агент: ключ из https://aistudio.google.com (Get API key). Пусто = демо-режим.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Оплата: Stripe → Developers → API keys (тестовый режим, sk_test_...). Пусто = демо-режим.
STRIPE_SECRET_KEY=
# Только если запускаете `stripe listen --forward-to localhost:8000/api/billing/webhook`
STRIPE_WEBHOOK_SECRET=
